#!/bin/sh
# Creates Craft's writable paths and hands them to www-data. Run as root after
# copying the project into /app:
#
#   USER root
#   COPY . .
#   RUN craft-prepare
#   USER www-data
#
# Override the paths with CRAFT_WRITABLE_PATHS (space separated, relative to /app).
set -eu

cd /app

paths="${CRAFT_WRITABLE_PATHS:-config storage web/cpresources web/assets}"

for path in $paths; do
  mkdir -p "$path"
done

# Touch .env so the chown succeeds even when Coolify injects env vars at runtime
# instead of providing a .env file in the build context.
touch .env

# shellcheck disable=SC2086
chown -R www-data:www-data $paths .env
# shellcheck disable=SC2086
chmod -R ug+rwX $paths .env
